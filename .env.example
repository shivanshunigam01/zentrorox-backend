# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/zentrosure

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Behind Nginx on EC2 (required for rate limit + X-Forwarded-For)
TRUST_PROXY=1

# Cloudinary (image uploads)
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=zentrosure
# Legacy alias (optional if CLOUDINARY_UPLOAD_FOLDER is set)
# CLOUDINARY_FOLDER=zentrosure

# Email — Nodemailer / Gmail (app password, no spaces in SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Your Workshop <your@gmail.com>"

# Optional: SendGrid instead of SMTP
# SENDGRID_API_KEY=
# EMAIL_FROM=

# Razorpay (backend only — never expose secrets to frontend)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
RAZORPAY_CURRENCY=INR
RAZORPAY_PAYMENT_LINK_EXPIRY_HOURS=24
PUBLIC_APP_URL=http://localhost:5173
